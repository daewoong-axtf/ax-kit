{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "c9bea9fecf35e54ac3c23bcb58da24baeb989f0f",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "pull-request-title-pattern": "chore: ${component} ${version} 릴리즈",
  "separate-pull-requests": true,
  "changelog-sections": [
    { "type": "feat", "section": "새로 추가된 기능" },
    { "type": "fix", "section": "수정된 문제" },
    { "type": "perf", "section": "개선 사항" }
  ],
  "packages": {
    "design-system": {
      "release-type": "node",
      "component": "design-system",
      "package-name": "design-system"
    },
    "rules/safety-rules": {
      "release-type": "simple",
      "component": "safety-rules"
    },
    "plugins/ax": {
      "release-type": "simple",
      "component": "ax",
      "extra-files": [{ "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" }]
    },
    "plugins/dds": {
      "release-type": "simple",
      "component": "dds",
      "extra-files": [{ "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" }]
    }
  }
}
